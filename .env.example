# Alleen nodig als je de AI-teksten wilt aanzetten. Zonder deze waarden werkt
# de site volledig, met de eigen templateteksten.
#
# Geheimen staan in Bitwarden Secrets Manager (project dev), niet in een .env.
# Een regel NAAM=bws:<secret-id> is een verwijzing; secrets-run haalt de waarde
# op en geeft die alleen aan het commando dat je start (in je eigen Terminal):
#   ~/.claude/bin/secrets-run -- npm start
ANTHROPIC_API_KEY=bws:9b1614f6-de0b-4c6d-9277-b5060087e873

# Optioneel een ander model:
# VIERDESPOOR_MODEL=claude-opus-5-5

# Zet op 1 als de AI-teksten ook mogen werken vanaf andere apparaten in je
# netwerk. Standaard uit: achter die route hangt je API-key.
# VIERDESPOOR_AI_LAN=1

# Cloudflare (tools/cloudflare-dns.mjs, worker/): het token komt uit Bitwarden,
# het account-id is geen geheim en blijft een gewone waarde.
CLOUDFLARE_API_TOKEN=bws:489e3146-e908-4767-8bea-b506008811a2
CLOUDFLARE_ACCOUNT_ID=35a7a483057685965614499cdc3381d2
