# Alleen nodig als je de AI-teksten wilt aanzetten. Zonder dit bestand werkt
# de site volledig, met de eigen templateteksten.
#
# Kopieer naar .env en vul je key in:
ANTHROPIC_API_KEY=sk-ant-...

# Optioneel een ander model:
# VIERDESPOOR_MODEL=claude-opus-5-5

# Zet op 1 als de AI-teksten ook mogen werken vanaf andere apparaten in je
# netwerk. Standaard uit: achter die route hangt je API-key.
# VIERDESPOOR_AI_LAN=1
